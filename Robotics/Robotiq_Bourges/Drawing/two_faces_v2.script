def two_faces_v2():

  # --- Read current TCP as reference (center between faces) ---
  pose0 = get_actual_tcp_pose()

  x_c = pose0[0]
  y_c = pose0[1]
  global z0  = pose0[2]
  global rx  = pose0[3]
  global ry  = pose0[4]
  global rz  = pose0[5]

  # --- Drawing parameters ---
  global a = 0.30        # acceleration (m/s^2)
  global v = 0.05        # speed (m/s)
  global lift = 0.01     # 1 cm lift between strokes
  r_face = 0.04   # 8 cm face radius
  spacing = 0.12  # 12 cm between face centers

  # --- Helper variables ---
  global x_cur = x_c
  global y_cur = y_c

  # --- Helper functions ---
  def go_xy_up(x, y):
    global x_cur = x
    global y_cur = y
    movel(p[x, y, z0 + lift, rx, ry, rz], a, v)
  end

  def go_xy_draw(x, y):
    global x_cur = x
    global y_cur = y
    movel(p[x, y, z0, rx, ry, rz], a, v)
  end

  def pen_up():
    movel(p[x_cur, y_cur, z0 + lift, rx, ry, rz], a, v)
  end

  def pen_down():
    movel(p[x_cur, y_cur, z0, rx, ry, rz], a, v)
  end

  def draw_arc(cx, cy, r, deg_start, deg_end, step):
    i = deg_start
    while i <= deg_end:
      ang = i * 3.14159 / 180
      x = cx + r * cos(ang)
      y = cy + r * sin(ang)
      go_xy_draw(x, y)
      i = i + step
    end
  end

  def stroke(x1, y1, x2, y2):
    go_xy_up(x1, y1)
    pen_down()
    go_xy_draw(x2, y2)
    pen_up()
  end

  def draw_circle(cx, cy, r, step):
    go_xy_up(cx + r, cy)
    pen_down()
    draw_arc(cx, cy, r, 0, 360, step)
    pen_up()
  end

  # =====================================================
  # =========== FACE 1 (HAPPY WITH STRAIGHT HAIR) =======
  # =====================================================

  x1 = x_c - spacing/2
  y1 = y_c

  # Face outline
  draw_circle(x1, y1, r_face, 5)

  # Straight hair (long strands)
  stroke(x1 - 0.030, y1 + r_face*0.90, x1 - 0.030, y1 + r_face*1.35)
  stroke(x1 - 0.020, y1 + r_face*0.95, x1 - 0.020, y1 + r_face*1.40)
  stroke(x1 - 0.010, y1 + r_face*0.98, x1 - 0.010, y1 + r_face*1.43)
  stroke(x1, y1 + r_face, x1, y1 + r_face*1.45)
  stroke(x1 + 0.010, y1 + r_face*0.98, x1 + 0.010, y1 + r_face*1.43)
  stroke(x1 + 0.020, y1 + r_face*0.95, x1 + 0.020, y1 + r_face*1.40)
  stroke(x1 + 0.030, y1 + r_face*0.90, x1 + 0.030, y1 + r_face*1.35)

  # Eyes (simple circles)
  draw_circle(x1 - 0.015, y1 + 0.010, 0.005, 10)
  draw_circle(x1 + 0.015, y1 + 0.010, 0.005, 10)

  # Nose
  stroke(x1, y1 - 0.005, x1, y1 - 0.015)

  # Smile
  go_xy_up(x1 + 0.020, y1 - 0.010)
  pen_down()
  draw_arc(x1, y1 - 0.010, 0.020, 200, 340, 5)
  pen_up()

  # =====================================================
  # ====== FACE 2 (DRAMATIC WITH CURLS AND GLASSES) =====
  # =====================================================

  x2 = x_c + spacing/2
  y2 = y_c

  # Face outline
  draw_circle(x2, y2, r_face, 5)

  # Curly hair (wavy top) - more pronounced waves
  i = -90
  while i <= 90:
    ang = i * 3.14159 / 180
    r = r_face + 0.015 * sin(8*ang)
    x = x2 + r * cos(ang)
    y = y2 + r * sin(ang)
    if i == -90:
      go_xy_up(x, y)
      pen_down()
    else:
      go_xy_draw(x, y)
    end
    i = i + 3
  end
  pen_up()

  # Additional curls on sides
  go_xy_up(x2 - r_face*0.85, y2 + r_face*0.4)
  pen_down()
  draw_arc(x2 - r_face*0.95, y2 + r_face*0.5, 0.015, 180, 540, 10)
  pen_up()
  
  go_xy_up(x2 + r_face*0.85, y2 + r_face*0.4)
  pen_down()
  draw_arc(x2 + r_face*0.95, y2 + r_face*0.5, 0.015, 0, 360, 10)
  pen_up()

  # Eyebrows (more dramatic/arched)
  stroke(x2 - 0.030, y2 + 0.018, x2 - 0.010, y2 + 0.022)
  stroke(x2 + 0.010, y2 + 0.022, x2 + 0.030, y2 + 0.018)

  # Glasses (round frames)
  draw_circle(x2 - 0.018, y2 + 0.005, 0.010, 10)
  draw_circle(x2 + 0.018, y2 + 0.005, 0.010, 10)
  stroke(x2 - 0.008, y2 + 0.005, x2 + 0.008, y2 + 0.005)
  stroke(x2 - 0.028, y2 + 0.005, x2 - 0.042, y2 + 0.008)
  stroke(x2 + 0.028, y2 + 0.005, x2 + 0.042, y2 + 0.008)

  # Nose (small hook)
  go_xy_up(x2, y2)
  pen_down()
  go_xy_draw(x2, y2 - 0.012)
  draw_arc(x2 - 0.005, y2 - 0.012, 0.005, 0, 90, 10)
  pen_up()

  # Frown (more dramatic)
  go_xy_up(x2 - 0.022, y2 - 0.018)
  pen_down()
  draw_arc(x2, y2 - 0.012, 0.022, 200, 340, 5)
  pen_up()

  # Tear (larger and more visible)
  draw_circle(x2 - 0.020, y2, 0.006, 10)

  # Shirt collar
  stroke(x2 - 0.020, y2 - r_face*0.85, x2, y2 - r_face*0.65)
  stroke(x2 + 0.020, y2 - r_face*0.85, x2, y2 - r_face*0.65)

end

two_faces_v2()
