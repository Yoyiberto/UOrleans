    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)
    movel(p[x_c + -0.036942, y_c + 0.100761, z_c, rx, ry, rz], a, v)

    # Lift pen at end
    movel(p[x_c, y_c, z_c + z_lift, rx, ry, rz], a, v)
end

