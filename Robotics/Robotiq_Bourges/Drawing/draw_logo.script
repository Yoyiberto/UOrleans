def draw_image():
    # Get current TCP pose as starting reference (center of A4 paper)
    pose0 = get_actual_tcp_pose()
    x_c = pose0[0]
    y_c = pose0[1]
    z_c = pose0[2]
    rx  = pose0[3]
    ry  = pose0[4]
    rz  = pose0[5]

    # Movement parameters
    a = 0.3      # acceleration
    v = 0.05     # velocity
    z_lift = 0.01  # lift height between paths

    # A4 paper dimensions: 0.21m x 0.297m
    # SVG dimensions: 268.65231 x 393.11508

    # --- Path segment 1 ---
    # Move to start of segment (pen up)
    movel(p[x_c + -0.029184, y_c + -0.124246, z_c + z_lift, rx, ry, rz], a, v)
    # Lower pen
    movel(p[x_c + -0.029184, y_c + -0.124246, z_c, rx, ry, rz], a, v)

